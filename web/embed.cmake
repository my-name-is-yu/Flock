file(GLOB_RECURSE assets RELATIVE "${asset_dir}" LIST_DIRECTORIES false "${asset_dir}/*")
set(header "#pragma once\n#include <string>\n#include <string_view>\n\nnamespace flockv0::web {\nstruct Asset { std::string_view path, type; std::string body; };\ninline const Asset assets[] = {\n")
foreach(path IN LISTS assets)
  if(path MATCHES "\\.html$")
    set(type "text/html; charset=utf-8")
  elseif(path MATCHES "\\.css$")
    set(type "text/css; charset=utf-8")
  elseif(path MATCHES "\\.js$")
    set(type "text/javascript; charset=utf-8")
  elseif(path MATCHES "\\.svg$")
    set(type "image/svg+xml")
  elseif(path MATCHES "/LICENSE$")
    set(type "text/plain; charset=utf-8")
  else()
    message(FATAL_ERROR "Unknown Web asset type for ${path}")
  endif()
  file(READ "${asset_dir}/${path}" content)
  string(FIND "${content}" ")FLOCK_ASSET\"" delimiter)
  if(NOT delimiter EQUAL -1)
    message(FATAL_ERROR "Reserved C++ raw string delimiter in ${path}")
  endif()
  string(APPEND header "  {\"/${path}\", \"${type}\", std::string(")
  string(LENGTH "${content}" length)
  while(length GREATER 40000)
    string(SUBSTRING "${content}" 0 40000 prefix)
    string(FIND "${prefix}" "\n" split REVERSE)
    if(split LESS 0)
      message(FATAL_ERROR "Asset line exceeds chunk limit in ${path}")
    endif()
    math(EXPR split "${split} + 1")
    string(SUBSTRING "${content}" 0 ${split} prefix)
    string(APPEND header "R\"FLOCK_ASSET(${prefix})FLOCK_ASSET\") + std::string(")
    string(SUBSTRING "${content}" ${split} -1 content)
    string(LENGTH "${content}" length)
  endwhile()
  string(APPEND header "R\"FLOCK_ASSET(${content})FLOCK_ASSET\")},\n")
endforeach()
string(APPEND header "};\n}\n")
file(WRITE "${output}" "${header}")
